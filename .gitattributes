# Normalise line endings so the repo stays LF regardless of who checks it out.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.ttf binary
*.woff binary
*.woff2 binary
